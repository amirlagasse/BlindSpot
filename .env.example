# Supabase. Get these from the project's API settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Environment data provider: "seeded" (committed JSON) or "live" (government APIs).
# "live" is stubbed in v1 and will throw NotImplementedError.
# There is deliberately no fallback from live to seeded.
ENVIRONMENT_PROVIDER=seeded
